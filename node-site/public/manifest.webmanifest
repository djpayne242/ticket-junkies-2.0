{
  "id": "/",
  "name": "TicketJunkies.com",
  "short_name": "TicketJunkies",
  "description": "Discover events and buy tickets in The Bahamas. Your tickets open even offline.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#376eb8",
  "categories": ["entertainment", "events", "lifestyle"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My tickets", "url": "/?source=app#/tickets", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Browse events", "url": "/?source=app#/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan tickets (promoters)", "url": "/?app=scanner#/scan", "icons": [{ "src": "/scanner-192.png", "sizes": "192x192" }] }
  ]
}
